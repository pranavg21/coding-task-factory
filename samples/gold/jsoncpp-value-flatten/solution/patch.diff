+static void flattenInto(const Value& node, const String& path, char separator,
+                        Value& out) {
+  const bool container = node.isObject() || node.isArray();
+  if (!container || node.empty()) {
+    out[path] = node;
+    return;
+  }
+  const String prefix = path.empty() ? String() : path + separator;
+  if (node.isArray()) {
+    for (ArrayIndex i = 0; i < node.size(); ++i)
+      flattenInto(node[i], prefix + std::to_string(i), separator, out);
+    return;
+  }
+  for (auto it = node.begin(); it != node.end(); ++it)
+    flattenInto(*it, prefix + it.name(), separator, out);
+}
+
+Value Value::flatten(char separator) const {
+  Value out(objectValue);
+  flattenInto(*this, String(), separator, out);
+  return out;
+}
